        "# main.py\n",
        "# Program Pencatatan Hasil Panen Digital\n",
        "# Fitur: input_data() -- Anggota A\n",
        "\n",
        "data_panen = {\n",
        "    \"Padi\": 120,\n",
        "    \"Jagung\": 80,\n",
        "    \"Kedelai\": 45\n",
        "}\n",
        "\n",
PERSEN_DISKON = 10
        "def hitung_total(data):\n",
        "    \"\"\"Menghitung total hasil panen (dalam kg) dari seluruh komoditas.\"\"\"\n",
        "    return sum(data.values())\n",
        "\n",
def hitung_diskon(total, persen_diskon):
    """Menghitung nilai akhir setelah dipotong diskon dari total hasil panen."""
    potongan = total * (persen_diskon / 100)
    return total - potongan
        "def input_data():\n",
        "    \"\"\"\n",
        "    Meminta pengguna memasukkan data hasil panen baru (nama komoditas & jumlah),\n",
        "    lalu menambahkan atau memperbarui data pada dictionary data_panen.\n",
        "    \"\"\"\n",
        "    komoditas = input(\"Masukkan nama komoditas: \").strip().title()\n",
        "\n",
        "    while True:\n",
        "        jumlah_input = input(f\"Masukkan jumlah hasil panen {komoditas} (kg): \").strip()\n",
        "        try:\n",
        "            jumlah = float(jumlah_input)\n",
        "            if jumlah < 0:\n",
        "                print(\"Jumlah tidak boleh negatif. Coba lagi.\")\n",
        "                continue\n",
        "            break\n",
        "        except ValueError:\n",
        "            print(\"Input harus berupa angka. Coba lagi.\")\n",
        "\n",
        "    if komoditas in data_panen:\n",
        "        print(f\"Komoditas '{komoditas}' sudah ada dengan jumlah {data_panen[komoditas]} kg.\")\n",
        "        data_panen[komoditas] += jumlah\n",
        "        print(f\"Data diperbarui: {komoditas} sekarang menjadi {data_panen[komoditas]} kg.\")\n",
        "    else:\n",
        "        data_panen[komoditas] = jumlah\n",
        "        print(f\"Data baru ditambahkan: {komoditas} sebanyak {jumlah} kg.\")\n",
        "\n",
        "def tampilkan_data():\n",
        "    \"\"\"Menampilkan seluruh data hasil panen yang tersimpan saat ini.\"\"\"\n",
        "    print(\"\\n=== Data Hasil Panen Saat Ini ===\")\n",
        "    for komoditas, jumlah in data_panen.items():\n",
        "        print(f\"{komoditas}: {jumlah} kg\")\n",
        "    print(f\"Total: {hitung_total(data_panen)} kg\\n\")\n",
        "\n",
        "def main():\n",
        "    while True:\n",
        "        print(\"\\n=== MENU ===\")\n",
        "        print(\"1. Tambah data hasil panen\")\n",
        "        print(\"2. Lihat data hasil panen\")\n",
        "        print(\"3. Keluar\")\n",
        "        pilihan = input(\"Pilih menu (1/2/3): \").strip()\n",
        "\n",
        "        if pilihan == \"1\":\n",
        "            input_data()\n",
        "        elif pilihan == \"2\":\n",
        "            tampilkan_data()\n",
        "        elif pilihan == \"3\":\n",
        "            print(\"Program selesai.\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"Pilihan tidak dikenali, coba lagi.\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
